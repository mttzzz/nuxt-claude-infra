{
  "name": "@mttzzz/nuxt-claude-infra",
  "version": "1.0.0",
  "type": "module",
  "description": "Host-stack test infra for Nuxt projects: per-worker DB + N parallel preview-серверов; Claude session hooks; commit-files / kill-zombies CLIs",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mttzzz/nuxt-claude-infra.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./host-stack": {
      "types": "./dist/host-stack/index.d.ts",
      "default": "./dist/host-stack/index.js"
    },
    "./host-stack/setup": {
      "types": "./dist/host-stack/setup/index.d.ts",
      "default": "./dist/host-stack/setup/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./cli/*": {
      "types": "./dist/cli/*.d.ts",
      "default": "./dist/cli/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "bin": {
    "nci-commit-files": "./dist/cli/commit-files.js",
    "nci-kill-zombies": "./dist/cli/kill-zombies.js",
    "nci-hook-session-start": "./dist/hooks/session-start.js",
    "nci-hook-session-end": "./dist/hooks/session-end.js",
    "nci-hook-pre-tool-use": "./dist/hooks/pre-tool-use.js",
    "nci-hook-post-tool-use": "./dist/hooks/post-tool-use.js"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "zod": "^4.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
