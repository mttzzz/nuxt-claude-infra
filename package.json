{
  "name": "@mttzzz/nuxt-claude-infra",
  "version": "2.0.2",
  "type": "module",
  "description": "Host-stack test infra for Nuxt projects: per-worker DB + N parallel preview-серверов. Pure TypeScript devDep, no bins.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mttzzz/nuxt-claude-infra.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host-stack": {
      "types": "./dist/host-stack/index.d.ts",
      "default": "./dist/host-stack/index.js"
    },
    "./host-stack/db": {
      "types": "./dist/host-stack/db.d.ts",
      "default": "./dist/host-stack/db.js"
    },
    "./host-stack/setup": {
      "types": "./dist/host-stack/setup/index.d.ts",
      "default": "./dist/host-stack/setup/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/test-utils": { "optional": true },
    "vitest": { "optional": true }
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
